{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": 8.0 }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Scene 1 prompt" },
    "inputs": {
      "clip": ["2", 0],
      "text": "A lighthouse on a rocky coast at dusk, waves breaking below. Camera: dolly in. Movement: move the camera physically forward in a straight line toward the lighthouse. Speed: slow and steady. Framing: keep the lighthouse centered. End: finish closer, with the lantern room large in frame."
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative prompt (shared)" },
    "inputs": { "clip": ["2", 0], "text": "cuts, scene change, camera shake, blurry, distorted" }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "Start frame" },
    "inputs": { "image": "example.png" }
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": { "title": "Clip 1 latent (from the start frame)" },
    "inputs": { "vae": ["3", 0], "width": 1280, "height": 704, "length": 49, "batch_size": 1, "start_image": ["7", 0] }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "seed": 1,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["8", 0],
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Clip 1" },
    "inputs": { "samples": ["9", 0], "vae": ["3", 0] }
  },
  "11": {
    "class_type": "FXIFrameChainStep",
    "_meta": { "title": "Frame Chain Step 1" },
    "inputs": { "clip": ["10", 0], "offset_from_end": 0 }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Scene 2 prompt" },
    "inputs": {
      "clip": ["2", 0],
      "text": "The lantern room of a lighthouse at dusk, the great lens glowing. Camera: orbit clockwise. Movement: circle clockwise around the lantern at a consistent radius. Speed: slow and even. Framing: keep the lens centered. End: finish a quarter turn around, the sea behind it."
    }
  },
  "13": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": { "title": "Clip 2 latent (from clip 1's last frame)" },
    "inputs": { "vae": ["3", 0], "width": 1280, "height": 704, "length": 49, "batch_size": 1, "start_image": ["11", 1] }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "seed": 2,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["12", 0],
      "negative": ["6", 0],
      "latent_image": ["13", 0],
      "denoise": 1.0
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Clip 2" },
    "inputs": { "samples": ["14", 0], "vae": ["3", 0] }
  },
  "16": {
    "class_type": "FXIFrameChainStep",
    "_meta": { "title": "Frame Chain Step 2" },
    "inputs": { "clip": ["15", 0], "offset_from_end": 0, "chain": ["11", 0] }
  },
  "17": {
    "class_type": "FXIStitchClips",
    "inputs": {
      "chain": ["16", 0],
      "drop_seam_frames": true,
      "ramp_fast": 1.0,
      "ramp_hold": 1.0,
      "ramp_split": 0.5,
      "resize": "error"
    }
  },
  "18": {
    "class_type": "SaveAnimatedWEBP",
    "inputs": {
      "images": ["17", 0],
      "filename_prefix": "fxi-frame-chain/two-clip-chain",
      "fps": 24.0,
      "lossless": false,
      "quality": 85,
      "method": "default"
    }
  }
}
